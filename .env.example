# Copy to .env and adjust. .env is gitignored and must never be committed.

# --- Postgres (consumed by the postgres container itself) ---
POSTGRES_USER=rhmg
POSTGRES_PASSWORD=rhmg_local_dev_only
POSTGRES_DB=rhmg

# --- Application ---
# Host is the compose SERVICE NAME, not localhost. Inside a container,
# localhost refers to that container, not the host machine.
RHMG_DATABASE_URL=postgresql+asyncpg://rhmg:rhmg_local_dev_only@postgres:5432/rhmg
RHMG_REDIS_URL=redis://redis:6379/0

RHMG_ENV=local
RHMG_LOG_LEVEL=INFO

# --- Telegram (Day 2 — leave blank until then) ---
RHMG_TELEGRAM_BOT_TOKEN=
